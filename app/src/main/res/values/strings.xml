    <string name="common_unplayed">Unplayed</string>
    <!-- Program is Gone: its server ID is no longer in the server listing -->
    <string name="common_program_gone">Not found on the server</string>
    <!-- Total size and count of files on the device: %1$s = "12.3 GB", %2$d = episode count -->
