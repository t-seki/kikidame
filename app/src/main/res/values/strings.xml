<?xml version="1.0" encoding="utf-8"?>
<!--
  Default (English) strings. Japanese lives in values-ja/. Every key must exist in both files (lint: MissingTranslation).
  Terms follow CONTEXT.md: Program (番組), Episode (各回), Publisher (配信元), Published (公開日), Performers (出演者),
  Pinned (固定), Starred (よく聴く), On Hold (判断保留), Gone (消失), Played (再生済み), Now Playing (聴いている回),
  Sleep Timer (スリープタイマー), Retention Rule (保持ルール), Sync (同期).
  Keys are <area>_<what>. Positional format arguments (%1$s) so translations can reorder them.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name" translatable="false">Kikidame</string>

    <!-- ===== common: shared across screens ===== -->
    <!-- Back navigation icon -->
    <string name="common_back">Back</string>
    <string name="common_cancel">Cancel</string>
