    <string name="common_list_separator">", "</string>
    <!-- Value shown when a field has no value (performers, server ID) -->
    <string name="common_none">None</string>
    <!-- Value shown when a field is not known (publisher, file size) -->
    <string name="common_unknown">Unknown</string>
    <string name="common_play">Play</string>
    <string name="common_pause">Pause</string>
